---
import BaseLayout from '../layouts/BaseLayout.astro';
import releasesData from '../../the-moon-os/data/releases.json';
import { Play } from 'lucide-astro';

// Same cleanup as api/promo/download.ts — older catalog entries carry an
// "Artist   Title" prefix separated by multiple spaces.
const clean = (t: string) => t.replace(/^.*?\s{2,}/, '').trim() || t;

const tracks = releasesData.releases.flatMap((r: any) =>
  (r.tracks ?? []).map((t: any) => ({
    title:   clean(t.title),
    artist:  r.artist,
    release: r.title,
    catalog: r.catalog,
    url:     t.url,
    cover:   r.artwork?.['600']?.jpg  ?? r.cover,
    bg:      r.artwork?.['1500']?.jpg ?? r.cover,
  })),
);
---

<BaseLayout
  title="Listen — THE MOON RECORDS"
  description="The Moon Records radio. All releases, shuffled. Ambient, drone, soundscape."
>
  <section
    class="relative min-h-dvh overflow-hidden"
    id="listen"
    data-tracks={JSON.stringify(tracks)}>

    <!-- ── Background: two layers crossfading on track change ─────────────── -->
    <div
      class="absolute inset-0 bg-cover bg-center scale-110 blur-3xl opacity-0 transition-opacity duration-[1200ms] ease-out motion-reduce:transition-none"
      data-bg="a" aria-hidden="true">
    </div>
    <div
      class="absolute inset-0 bg-cover bg-center scale-110 blur-3xl opacity-0 transition-opacity duration-[1200ms] ease-out motion-reduce:transition-none"
      data-bg="b" aria-hidden="true">
    </div>
    <div class="absolute inset-0 bg-bg/88" aria-hidden="true"></div>
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_60%_55%_at_50%_45%,transparent_0%,rgba(12,12,12,0.75)_100%)]"
      aria-hidden="true">
    </div>

    <!-- ── Content ────────────────────────────────────────────────────────── -->
    <div class="relative flex min-h-dvh flex-col justify-center px-6 lg:px-10 pt-20 pb-44 md:pt-24 md:pb-16">
      <div class="mx-auto w-full max-w-4xl">

        <div class="flex flex-col gap-7 md:grid md:grid-cols-[auto_1fr] md:gap-14 md:items-center">

          <!-- Cover -->
          <div class="mx-auto md:mx-0">
            <div class="w-[min(62vw,15rem)] aspect-square border border-border bg-surface-low overflow-hidden md:w-72">
            <img
              data-cover
              src=""
              alt=""
              width="288"
              height="288"
              class="w-full h-full object-cover opacity-0 transition-opacity duration-700 motion-reduce:transition-none"
            />
            </div>
          </div>

          <!-- Info + controls -->
          <div class="min-w-0 flex flex-col">

            <span class="flex items-center gap-2.5 font-mono text-[clamp(0.58rem,1.4vw,0.65rem)] tracking-[0.28em] sm:tracking-[0.35em] uppercase text-accent mb-3 md:mb-5">
              <span class="np-play flex items-center shrink-0" aria-hidden="true">
                <Play size={11} fill="currentColor" stroke-width={0} />
              </span>
    
              <span class="np-label">Now Playing</span>
            </span>

            <h1
              data-title
              class="font-label font-bold uppercase text-fg text-[clamp(1.45rem,6vw,2.6rem)] tracking-[0.04em] sm:tracking-[0.06em] leading-[1.12] mb-2 md:mb-3 break-words hyphens-auto">
              —
            </h1>

            <p class="font-label font-light text-[clamp(0.7rem,2vw,0.8rem)] tracking-[0.2em] sm:tracking-[0.28em] uppercase text-fg-dim mb-1">
              <span data-artist>—</span>
            </p>
            <p class="font-mono text-[clamp(0.58rem,1.5vw,0.66rem)] tracking-[0.16em] sm:tracking-[0.22em] uppercase text-fg-muted mb-5 md:mb-8">
              <span data-release>—</span>
            </p>

            <!-- Transport bar: pinned to the bottom on mobile so the controls
                 are always reachable; back in the flow from md upwards. -->
            <div
              class="fixed inset-x-0 bottom-0 z-100 border-t border-border bg-bg/95 backdrop-blur-md px-6 pt-2 pb-[calc(env(safe-area-inset-bottom,0px)+0.5rem)] md:static md:z-auto md:border-0 md:bg-transparent md:backdrop-blur-none md:p-0">

            <!-- Progress -->
            <div class="flex items-center gap-3 mb-1.5 md:mb-3">
              <span data-time-current class="font-mono text-[0.6rem] tracking-[0.12em] text-fg-muted tabular-nums shrink-0 w-9">0:00</span>
              <div
                data-progress
                role="slider"
                tabindex="0"
                aria-label="Seek"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
                class="group relative h-5 flex-1 flex items-center cursor-pointer focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-4">
                <div class="relative w-full h-px bg-accent/25">
                  <div data-fill class="absolute inset-y-0 left-0 w-0 bg-accent"></div>
                  <div
                    data-head
                    class="absolute top-1/2 left-0 w-2 h-2 -translate-x-1/2 -translate-y-1/2 bg-accent opacity-0 group-hover:opacity-100 transition-opacity">
                  </div>
                </div>
              </div>
              <span data-time-total class="font-mono text-[0.6rem] tracking-[0.12em] text-fg-muted tabular-nums shrink-0 w-9 text-right">0:00</span>
            </div>


            <!-- Transport -->
            <div class="flex items-center gap-2 sm:gap-3 [&>button]:relative [&>button]:after:absolute [&>button]:after:inset-x-0 [&>button]:after:-inset-y-2 [&>button]:after:content-['']">

              <button
                data-shuffle
                type="button"
                aria-pressed="true"
                aria-label="Toggle shuffle"
                class="w-8 h-8 flex items-center justify-center text-accent hover:text-fg transition-colors duration-200 cursor-pointer">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M1 3h3l3 5 3 5h4M1 13h3l2-3M11 11l3 2-3 2M11 1l3 2-3 2M12 3h-2l-1.5 2.5"/>
                </svg>
              </button>

              <button
                data-prev
                type="button"
                aria-label="Previous track"
                class="w-8 h-8 flex items-center justify-center text-fg-dim hover:text-fg transition-colors duration-200 cursor-pointer">
                <svg width="16" height="16" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
                  <rect x="0" y="1" width="2" height="12"/>
                  <polygon points="12,1 2,7 12,13"/>
                </svg>
              </button>

              <button
                data-play
                type="button"
                aria-label="Play"
                class="w-12 h-9 flex items-center justify-center bg-accent text-bg hover:bg-[#D4C99A] transition-colors duration-200 cursor-pointer">
                <svg data-icon-play width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <polygon points="3,1 13,8 3,15"/>
                </svg>
                <svg data-icon-pause class="hidden" width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <rect x="2" y="1" width="4" height="14"/>
                  <rect x="10" y="1" width="4" height="14"/>
                </svg>
              </button>

              <button
                data-next
                type="button"
                aria-label="Next track"
                class="w-8 h-8 flex items-center justify-center text-fg-dim hover:text-fg transition-colors duration-200 cursor-pointer">
                <svg width="16" height="16" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
                  <rect x="12" y="1" width="2" height="12"/>
                  <polygon points="2,1 12,7 2,13"/>
                </svg>
              </button>

              <button
                data-open-playlist
                type="button"
                aria-label="Open playlist"
                class="ml-auto h-9 px-3 sm:px-4 flex items-center gap-2 sm:gap-2.5 border border-border text-fg-muted hover:text-fg hover:border-accent transition-colors duration-200 cursor-pointer font-mono text-[clamp(0.58rem,1.4vw,0.62rem)] tracking-[0.18em] sm:tracking-[0.22em] uppercase">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
                  <rect x="0" y="1" width="12" height="1.5"/>
                  <rect x="0" y="5.25" width="12" height="1.5"/>
                  <rect x="0" y="9.5" width="8" height="1.5"/>
                </svg>
                <span data-count>{tracks.length}</span>
              </button>

            </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Playlist overlay ───────────────────────────────────────────────── -->
    <div
      data-playlist
      role="dialog"
      aria-modal="true"
      aria-label="Playlist"
      class="fixed inset-0 z-200 hidden">

      <div data-playlist-scrim class="absolute inset-0 bg-bg/90 backdrop-blur-sm"></div>

      <div class="relative h-full flex flex-col max-w-3xl mx-auto px-6 lg:px-10 py-8">

        <div class="flex items-center justify-between gap-4 pb-4 mb-2 border-b border-border shrink-0">
          <span class="font-mono text-[clamp(0.58rem,1.5vw,0.65rem)] tracking-[0.24em] sm:tracking-[0.35em] uppercase text-accent">
            // Playlist — {tracks.length} Tracks
          </span>
          <button
            data-close-playlist
            type="button"
            aria-label="Close playlist"
            class="w-11 h-11 -mr-3 flex items-center justify-center text-fg-muted hover:text-fg transition-colors cursor-pointer">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M1 1l12 12M13 1L1 13"/>
            </svg>
          </button>
        </div>

        <ol data-lenis-prevent class="flex-1 min-h-0 overflow-y-auto overscroll-contain -mx-2">
          {tracks.map((t: any, i: number) => (
            <li>
              <button
                type="button"
                data-track-item={i}
                class="group w-full flex items-baseline gap-4 px-2 py-3 text-left border-b border-border/40 hover:bg-surface-low transition-colors cursor-pointer">
                <span data-pos class="font-mono text-[clamp(0.58rem,1.4vw,0.62rem)] tracking-[0.12em] text-fg-muted group-[.is-current]:text-accent w-7 sm:w-8 shrink-0">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block font-label font-light text-[clamp(0.82rem,2.2vw,0.9rem)] tracking-[0.04em] sm:tracking-[0.06em] text-fg-dim group-hover:text-fg group-[.is-current]:text-accent truncate">
                    {t.title}
                  </span>
                  <span class="block font-mono text-[clamp(0.56rem,1.3vw,0.6rem)] tracking-[0.13em] sm:tracking-[0.18em] uppercase text-fg-muted truncate mt-1">
                    {t.artist} — {t.release}
                  </span>
                </span>
                <span class="hidden sm:block font-mono text-[clamp(0.56rem,1.3vw,0.6rem)] tracking-[0.12em] text-fg-muted shrink-0">
                  {t.catalog}
                </span>
              </button>
            </li>
          ))}
        </ol>
      </div>
    </div>

  </section>
</BaseLayout>

<script>
  import { lockScroll, unlockScroll } from '../lib/scroll-lock';

  const root = document.getElementById('listen');
  if (root) {
    type Track = {
      title: string; artist: string; release: string;
      catalog: string; url: string; cover: string; bg: string;
    };

    const tracks: Track[] = JSON.parse(root.dataset.tracks ?? '[]');

    const $  = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const audio = new Audio();
    audio.preload = 'metadata';

    const elTitle   = $('[data-title]');
    const elArtist  = $('[data-artist]');
    const elRelease = $('[data-release]');
    const elCover   = $<HTMLImageElement>('[data-cover]');
    const bgA       = $('[data-bg="a"]');
    const bgB       = $('[data-bg="b"]');
    const btnPlay   = $<HTMLButtonElement>('[data-play]');
    const iconPlay  = $('[data-icon-play]');
    const iconPause = $('[data-icon-pause]');
    const btnShuffle= $<HTMLButtonElement>('[data-shuffle]');
    const progress  = $('[data-progress]');
    const fill      = $('[data-fill]');
    const head      = $('[data-head]');
    const tCurrent  = $('[data-time-current]');
    const tTotal    = $('[data-time-total]');
    const playlist  = $('[data-playlist]');

    // Fisher-Yates
    const shuffled = (n: number) => {
      const a = Array.from({ length: n }, (_, i) => i);
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    };

    let isShuffle = true;
    let order = shuffled(tracks.length);
    let pos = 0;                       // index into `order`
    let bgFront: HTMLElement = bgA;

    const trackIndex = () => order[pos];

    const fmt = (s: number) => {
      if (!isFinite(s) || s < 0) return '0:00';
      const m = Math.floor(s / 60);
      return `${m}:${Math.floor(s % 60).toString().padStart(2, '0')}`;
    };

    function paintBackground(url: string) {
      const back = bgFront === bgA ? bgB : bgA;
      back.style.backgroundImage = `url("${url}")`;
      back.style.opacity = '0.55';
      bgFront.style.opacity = '0';
      bgFront = back;
    }

    function markCurrent() {
      root.querySelectorAll('[data-track-item]').forEach((el) => el.classList.remove('is-current'));
      root.querySelector(`[data-track-item="${trackIndex()}"]`)?.classList.add('is-current');
    }

    // Playlist mirrors the real play order, so a shuffled queue looks shuffled.
    function renderOrder() {
      const list = root.querySelector('ol');
      if (!list) return;
      const rows = new Map<number, HTMLElement>();
      list.querySelectorAll<HTMLElement>('[data-track-item]').forEach((btn) => {
        rows.set(Number(btn.dataset.trackItem), btn.closest('li') as HTMLElement);
      });
      const frag = document.createDocumentFragment();
      order.forEach((trackIdx, i) => {
        const li = rows.get(trackIdx);
        if (!li) return;
        const num = li.querySelector('[data-pos]');
        if (num) num.textContent = String(i + 1).padStart(2, '0');
        frag.appendChild(li);
      });
      list.appendChild(frag);
    }

    function load(autoplay: boolean) {
      const t = tracks[trackIndex()];
      if (!t) return;

      elTitle.textContent   = t.title;
      elArtist.textContent  = t.artist;
      elRelease.textContent = `${t.release} · ${t.catalog}`;
      document.title = `${t.title} — ${t.artist} // THE MOON RECORDS`;

      elCover.style.opacity = '0';
      elCover.src = t.cover;
      elCover.alt = `${t.release} — ${t.artist}`;
      elCover.onload = () => { elCover.style.opacity = '1'; };

      paintBackground(t.bg);
      markCurrent();

      audio.src = t.url;
      fill.style.width = '0%';
      head.style.left = '0%';
      tCurrent.textContent = '0:00';
      tTotal.textContent = '0:00';

      if (autoplay) play();
    }

    function play() {
      audio.play().then(() => {
        iconPlay.classList.add('hidden');
        iconPause.classList.remove('hidden');
        btnPlay.setAttribute('aria-label', 'Pause');
        root.classList.add('is-playing');
      }).catch(() => { /* autoplay blocked — user presses play */ });
    }

    function pause() {
      audio.pause();
      iconPlay.classList.remove('hidden');
      iconPause.classList.add('hidden');
      btnPlay.setAttribute('aria-label', 'Play');
      root.classList.remove('is-playing');
    }

    const step = (delta: number) => {
      pos = (pos + delta + order.length) % order.length;
      load(true);
    };

    // ── Events ──────────────────────────────────────────────────────────────
    btnPlay.addEventListener('click', () => (audio.paused ? play() : pause()));
    $('[data-next]').addEventListener('click', () => step(1));
    $('[data-prev]').addEventListener('click', () => {
      if (audio.currentTime > 3) { audio.currentTime = 0; return; }
      step(-1);
    });

    btnShuffle.addEventListener('click', () => {
      isShuffle = !isShuffle;
      const current = trackIndex();
      order = isShuffle ? shuffled(tracks.length) : Array.from({ length: tracks.length }, (_, i) => i);
      pos = Math.max(0, order.indexOf(current));   // keep playing what's playing
      btnShuffle.setAttribute('aria-pressed', String(isShuffle));
      btnShuffle.classList.toggle('text-accent', isShuffle);
      btnShuffle.classList.toggle('text-fg-muted', !isShuffle);
      renderOrder();
    });

    audio.addEventListener('timeupdate', () => {
      if (!audio.duration) return;
      const pct = (audio.currentTime / audio.duration) * 100;
      fill.style.width = `${pct}%`;
      head.style.left = `${pct}%`;
      tCurrent.textContent = fmt(audio.currentTime);
      progress.setAttribute('aria-valuenow', String(Math.round(pct)));
    });
    audio.addEventListener('loadedmetadata', () => { tTotal.textContent = fmt(audio.duration); });
    audio.addEventListener('ended', () => step(1));
    audio.addEventListener('error', () => step(1));   // skip unplayable track

    const seekTo = (clientX: number) => {
      if (!audio.duration) return;
      const r = progress.getBoundingClientRect();
      audio.currentTime = Math.min(1, Math.max(0, (clientX - r.left) / r.width)) * audio.duration;
    };
    progress.addEventListener('click', (e) => seekTo((e as MouseEvent).clientX));
    progress.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (k === 'ArrowRight') { audio.currentTime = Math.min(audio.duration, audio.currentTime + 5); e.preventDefault(); }
      if (k === 'ArrowLeft')  { audio.currentTime = Math.max(0, audio.currentTime - 5); e.preventDefault(); }
    });

    // ── Playlist ────────────────────────────────────────────────────────────
    const openPlaylist = () => {
      if (!playlist.classList.contains('hidden')) return;
      playlist.classList.remove('hidden');
      lockScroll();
    };

    const closePlaylist = () => {
      if (playlist.classList.contains('hidden')) return;
      playlist.classList.add('hidden');
      unlockScroll();
    };

    $('[data-open-playlist]').addEventListener('click', openPlaylist);
    $('[data-close-playlist]').addEventListener('click', closePlaylist);
    $('[data-playlist-scrim]').addEventListener('click', closePlaylist);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !playlist.classList.contains('hidden')) closePlaylist();
    });

    root.querySelectorAll<HTMLButtonElement>('[data-track-item]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.dataset.trackItem);
        const at = order.indexOf(idx);
        pos = at >= 0 ? at : 0;
        load(true);
        closePlaylist();
      });
    });

    // Space toggles playback unless a control is focused
    document.addEventListener('keydown', (e) => {
      if (e.code !== 'Space') return;
      const tag = (e.target as HTMLElement)?.tagName;
      if (tag === 'BUTTON' || tag === 'INPUT' || tag === 'TEXTAREA') return;
      e.preventDefault();
      audio.paused ? play() : pause();
    });

    if (tracks.length) { renderOrder(); load(false); }
  }
</script>

<style>
  /* Now-playing meter — four bars that idle flat and breathe during playback.
     Everything else on this page stays still: one moving element is enough. */
  .np-bar {
    transform-origin: bottom;
    transform: scaleY(0.14);
    opacity: 0.45;
    transition: transform 500ms ease-out, opacity 500ms ease-out;
  }

  #listen.is-playing .np-bar {
    animation: np-breathe 1.9s ease-in-out infinite;
    opacity: 1;
  }

  #listen.is-playing .np-bar:nth-child(2) { animation-delay: 0.24s; animation-duration: 2.3s; }
  #listen.is-playing .np-bar:nth-child(3) { animation-delay: 0.48s; animation-duration: 1.7s; }
  #listen.is-playing .np-bar:nth-child(4) { animation-delay: 0.12s; animation-duration: 2.1s; }

  /* Play glyph — dimmed while paused, softly pulsing during playback */
  .np-play {
    opacity: 0.3;
    transition: opacity 500ms ease-out;
  }

  #listen.is-playing .np-play {
    opacity: 1;
    animation: np-pulse 1.9s ease-in-out infinite;
  }

  .np-label {
    transition: opacity 600ms ease-out;
    opacity: 0.75;
  }

  #listen.is-playing .np-label {
    opacity: 1;
  }

  @keyframes np-pulse {
    0%, 100% { opacity: 0.55; transform: scale(0.9); }
    50%      { opacity: 1;    transform: scale(1.08); }
  }

  @keyframes np-breathe {
    0%, 100% { transform: scaleY(0.18); }
    50%      { transform: scaleY(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    #listen.is-playing .np-bar {
      animation: none;
      transform: scaleY(0.55);
    }
    #listen.is-playing .np-play {
      animation: none;
    }
  }
</style>
