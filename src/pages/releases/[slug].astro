---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import PhaseCircle from '../../components/PhaseCircle.astro';
import DspLinks from '../../components/DspLinks.astro';
import ReleaseCard from '../../components/ReleaseCard.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import releasesData from '../../../the-moon-os/data/releases.json';
import { getFeedbackForRelease } from '../../lib/pocketbase';
import { adjacent, isReleased as releaseIsOut, splitArtists, visiblePlatforms as platformsOf, yearOf } from '../../lib/release';
import { marked } from 'marked';

const { slug } = Astro.params;
const release = releasesData.releases.find(
  (r) => r.catalog.toLowerCase() === slug
);

if (!release) return Astro.redirect('/404');

const feedback = await getFeedbackForRelease(slug!);

// Four other releases, reshuffled per request (this page is SSR).
const others = releasesData.releases.filter((r) => r.catalog.toLowerCase() !== slug);
for (let i = others.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [others[i], others[j]] = [others[j], others[i]];
}
const alsoOn = others.slice(0, 4);

const { catalog, artist, title, format, year, genre, artwork, cover, tracks, platforms, release_date, about } = release;

// Strip a leading "# Title" line — the page already renders its own <h1>
const aboutHtml = about ? marked.parse(about.replace(/^#\s+.+\n+/, '')) : '';

const art1500webp = artwork?.['1500']?.webp;
const art1500jpg  = artwork?.['1500']?.jpg;

const playerTracks = tracks.map((t) => ({
  number: t.number,
  title:  t.title,
  url:    t.url,
}));

// Platform links stay hidden until release_date has passed
const releaseDate = release_date ? new Date(release_date) : null;
const isReleased = releaseIsOut(release);
const visiblePlatforms = platformsOf(release);
const displayYear = yearOf(release);

// Format release date for display
const formattedReleaseDate = releaseDate
  ? releaseDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' })
  : null;

const seoTitle       = `${artist} — ${title} | THE MOON RECORDS`;
const seoDescription = `${catalog}${genre ? ` · ${genre}` : ''}${year ? ` · ${year}` : ''} · ${tracks.length} track${tracks.length !== 1 ? 's' : ''}. Beatless music on The Moon Records.`;
// Purpose-built 1200x630 preview (see pages/og): square covers get cropped by Facebook.
const seoImage       = new URL(`og/${slug}.jpg`, Astro.site).href;
const seoUrl         = new URL(`releases/${slug}`, Astro.site).href;

// "Previous" = older, "next" = newer: real links so crawlers and visitors can walk the catalogue.
const { prev, next } = adjacent(release);

const group = (name: string) => ({ '@type': 'MusicGroup', name });
const artists = splitArtists(artist).map(group);
const hasMoreAbout = (String(aboutHtml).match(/<p>/g) ?? []).length > 1;
const entities: Record<string, string> = { '&quot;': '"', '&#39;': "'", '&lt;': '<', '&gt;': '>', '&amp;': '&' };
const aboutText = String(aboutHtml)
  .replace(/<[^>]+>/g, ' ')
  .replace(/&(quot|#39|lt|gt|amp);/g, (m) => entities[m])
  .replace(/\s+/g, ' ')
  .trim();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicAlbum',
  name: title,
  url: seoUrl,
  byArtist: artists.length === 1 ? artists[0] : artists,
  recordLabel: { '@type': 'Organization', name: 'The Moon Records' },
  image: art1500jpg || cover,
  ...(release_date && { datePublished: release_date }),
  ...(aboutText && { description: aboutText }),
  ...(visiblePlatforms.length && { sameAs: visiblePlatforms.map((p) => p.url) }),
  numTracks: tracks.length,
  track: tracks.map((t) => ({
    '@type': 'MusicRecording',
    name: t.title.replace(/^.*?\s{2,}/, '').trim() || t.title,
    position: t.number,
  })),
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={seoImage}
  imageWidth={1200}
  imageHeight={630}
  canonicalUrl={seoUrl}
  type="music.album"
>
  <div class="min-h-screen pb-12 sm:pb-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 pt-[var(--header-height)] sm:pt-8">

      <!-- ══ MOBILE (hidden on sm+) ══════════════════════════════════ -->
      <div class="sm:hidden flex flex-col gap-3 pb-6">

        <a
          href="/releases"
          class="flex items-center min-h-[44px] self-start font-mono text-[0.6rem] tracking-[0.25em] uppercase text-fg-muted no-underline transition-colors duration-200 hover:text-fg-dim"
        >← Releases</a>

        <!-- Card: cover left, artist / title / year right -->
        <div class="flex items-center gap-4">
          <div class="size-30 shrink-0">
            {art1500jpg ? (
              <picture>
                {art1500webp && <source srcset={art1500webp} type="image/webp" />}
                <img
                  class="release-artwork size-full object-cover block"
                  src={art1500jpg}
                  alt={`${artist} — ${title}`}
                  width="240"
                  height="240"
                />
              </picture>
            ) : (
              <div class="size-full bg-surface border border-border flex items-center justify-center">
                <PhaseCircle phase={0.74} size={48} label="No cover art" />
              </div>
            )}
          </div>

          <div class="min-w-0 flex flex-col gap-1">
            <span class="font-mono text-[0.6rem] tracking-[0.22em] uppercase text-accent">{artist}</span>
            <h1 class="font-label font-bold uppercase text-fg text-xl leading-tight break-words" style="letter-spacing: 0.05em;">{title}</h1>
            <span class="font-mono text-[0.55rem] tracking-[0.2em] uppercase text-fg-muted">
              {[catalog, format, displayYear].filter(Boolean).join(' · ')}
            </span>
          </div>
        </div>

        <!-- Two labelled rows: platforms (outlined tiles) vs. share (filled tiles) -->
        <div class="flex flex-col gap-3 border-t border-border pt-3">
          {visiblePlatforms.length > 0 && (
            <div class="flex flex-col gap-2">
              <span class="font-mono text-[0.55rem] tracking-[0.25em] uppercase text-fg-muted">Listen on</span>
              <DspLinks platforms={visiblePlatforms} size="h-5" gap="gap-2" tile />
            </div>
          )}
          <div class:list={['flex flex-col gap-2', visiblePlatforms.length > 0 && 'border-t border-border pt-3']}>
            <span class="font-mono text-[0.55rem] tracking-[0.25em] uppercase text-fg-muted">Share</span>
            <ShareButtons release={release} />
          </div>
        </div>

        <!-- Release date -->
        {formattedReleaseDate && (
          <div class="flex items-center gap-4 flex-wrap">
            <span class="font-mono text-[0.55rem] tracking-[0.2em] uppercase text-fg-muted">
              {isReleased ? 'Released' : 'Releasing'} {formattedReleaseDate}
            </span>
            {!isReleased && (
              <a href="/newsletter" class="inline-flex items-center min-h-[44px] font-mono text-[0.55rem] tracking-[0.2em] uppercase text-accent no-underline hover:opacity-70">
                Get notified ↗
              </a>
            )}
          </div>
        )}

        <!-- Compact audio player -->
        {isReleased ? (
          <AudioPlayer tracks={playerTracks} compact />
        ) : (
          <div class="border border-border p-4 flex flex-col gap-2">
            <span class="font-mono text-[0.6rem] tracking-[0.25em] uppercase text-accent">// TRANSMISSION_PENDING</span>
            <p class="font-mono text-[0.55rem] tracking-[0.18em] uppercase text-fg-muted">Available {formattedReleaseDate}</p>
          </div>
        )}

        <!-- About: first paragraph, rest behind "Read more" -->
        {aboutHtml && (
          <div class="group flex flex-col gap-2 pt-3 border-t border-border" data-readmore-group>
            <span class="font-mono text-[0.6rem] tracking-[0.25em] uppercase text-accent">// About</span>
            <div
              class="font-label text-[0.75rem] tracking-[0.04em] text-fg-dim leading-relaxed flex flex-col gap-3 [&_p]:m-0 [&>p:nth-child(n+2)]:hidden group-data-[open]:[&>p:nth-child(n+2)]:block"
              set:html={aboutHtml}
            />
            {hasMoreAbout && (
              <button
                type="button"
                data-readmore
                aria-expanded="false"
                class="self-start min-h-[44px] font-mono text-[0.6rem] tracking-[0.25em] uppercase text-accent hover:opacity-70">
                Read more
              </button>
            )}
          </div>
        )}

        <!-- Feedback -->
        {feedback.length > 0 && (
          <div class="flex flex-col gap-3 pt-2">
            <span class="font-mono text-[0.6rem] tracking-[0.25em] uppercase text-accent">// Transmissions</span>
            {feedback.map((f) => (
              <div class="border border-border p-4 flex flex-col gap-2">
                <p class="font-label text-[0.75rem] tracking-[0.08em] text-fg-dim leading-relaxed">"{f.comment}"</p>
                <div class="flex items-baseline gap-3 flex-wrap">
                  <span class="font-mono text-[0.55rem] tracking-[0.2em] uppercase text-fg-muted">{f.name}</span>
                  {f.url && (
                    <a href={f.url} target="_blank" rel="noopener noreferrer"
                      class="font-mono text-[0.5rem] tracking-[0.15em] uppercase text-accent no-underline opacity-70 hover:opacity-100 transition-opacity"
                    >{new URL(f.url).hostname} ↗</a>
                  )}
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- ══ DESKTOP (hidden on mobile) ════════════════════════════════ -->
      <div class="hidden sm:grid sm:grid-cols-2 sm:gap-12 lg:gap-16 items-start">

        <!-- Artwork -->
        <div class="sm:sticky sm:top-8">
          {art1500jpg ? (
            <picture>
              {art1500webp && <source srcset={art1500webp} type="image/webp" />}
              <img
                class="release-artwork w-full aspect-square object-cover block [filter:grayscale(0.2)_brightness(0.9)] hover:[filter:grayscale(0)_brightness(1)] transition-[filter] duration-300"
                src={art1500jpg}
                alt={`${artist} — ${title}`}
                width="600"
                height="600"
              />
            </picture>
          ) : (
            <div class="w-full aspect-square bg-surface border border-border flex items-center justify-center">
              <PhaseCircle phase={0.74} size={120} label="No cover art" />
            </div>
          )}
        </div>

        <!-- Info column -->
        <div class="flex flex-col gap-5">

          <div class="flex gap-1.5 flex-wrap">
            <span class="badge">{catalog}</span>
            {format && <span class="badge badge--muted">{format}</span>}
            {genre  && <span class="badge badge--muted">{genre}</span>}
            {year   && <span class="badge badge--muted">{year}</span>}
          </div>

          <h1
            id="release-title"
            class="font-label font-bold uppercase text-fg leading-[1.05]"
            style="font-size: clamp(1.5rem, 4vw, 2.5rem); letter-spacing: 0.06em;"
          >{title}</h1>

          <p class="font-label font-normal text-[0.75rem] tracking-[0.22em] uppercase text-accent">{artist}</p>

          <div class="flex items-center gap-6 pb-4 border-b border-border flex-wrap">
            <span class="font-mono text-[0.55rem] tracking-[0.2em] uppercase text-fg-muted">
              {tracks.length} track{tracks.length !== 1 ? 's' : ''}
            </span>
            <DspLinks platforms={visiblePlatforms} />
          </div>

          {formattedReleaseDate && (
            <div class="flex items-center gap-6 flex-wrap">
              <span class="font-mono text-[0.55rem] tracking-[0.2em] uppercase text-fg-muted">
                {isReleased ? 'Released' : 'Releasing'} {formattedReleaseDate}
              </span>
              {!isReleased && (
                <a href="/newsletter" class="font-mono text-[0.55rem] tracking-[0.2em] uppercase text-accent no-underline transition-opacity duration-200 hover:opacity-70">
                  Get notified ↗
                </a>
              )}
            </div>
          )}

          <div class="flex items-center gap-4">
            <span class="font-mono text-[0.55rem] tracking-[0.2em] uppercase text-fg-muted">Share</span>
            <ShareButtons release={release} />
          </div>

          <div class="flex items-center gap-4">
            <PhaseCircle phase={0.74} size={48} label="Phase indicator" />
            <span class="font-mono text-[0.55rem] tracking-[0.22em] uppercase text-fg-muted">{catalog}</span>
          </div>

          {isReleased ? (
            <AudioPlayer tracks={playerTracks} />
          ) : (
            <div class="border border-border p-5 flex flex-col gap-2">
              <span class="font-mono text-[0.6rem] tracking-[0.25em] uppercase text-accent">// TRANSMISSION_PENDING</span>
              <p class="font-mono text-[0.55rem] tracking-[0.18em] uppercase text-fg-muted">Available {formattedReleaseDate}</p>
            </div>
          )}

          {aboutHtml && (
            <div class="flex flex-col gap-4 pt-2">
              <span class="font-mono text-[0.6rem] tracking-[0.25em] uppercase text-accent">// About</span>
              <div class="font-label text-[0.75rem] tracking-[0.04em] text-fg-dim leading-relaxed flex flex-col gap-3 [&_p]:m-0" set:html={aboutHtml} />
            </div>
          )}

          {feedback.length > 0 && (
            <div class="flex flex-col gap-4 pt-2">
              <span class="font-mono text-[0.6rem] tracking-[0.25em] uppercase text-accent">// Transmissions</span>
              {feedback.map((f) => (
                <div class="border border-border p-4 flex flex-col gap-2">
                  <p class="font-label text-[0.75rem] tracking-[0.08em] text-fg-dim leading-relaxed">"{f.comment}"</p>
                  <div class="flex items-baseline gap-3 flex-wrap">
                    <span class="font-mono text-[0.55rem] tracking-[0.2em] uppercase text-fg-muted">{f.name}</span>
                    {f.url && (
                      <a href={f.url} target="_blank" rel="noopener noreferrer"
                        class="font-mono text-[0.5rem] tracking-[0.15em] uppercase text-accent no-underline opacity-70 hover:opacity-100 transition-opacity"
                      >{new URL(f.url).hostname} ↗</a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          )}

        </div>
      </div>

    </div>

    {alsoOn.length > 0 && (
      <section class="container mx-auto px-4 sm:px-6 lg:px-8 mt-12 sm:mt-24">
        <div class="tmr-section-header">
          <span class="tmr-section-num">///</span>
          <span class="tmr-section-title">More from the label</span>
          <span class="tmr-section-sub">Catalogue</span>
        </div>

        <ul class="sm:hidden flex flex-col list-none m-0 p-0">
          {alsoOn.map((r) => (
            <li class="relative flex items-center gap-3 py-2 border-b border-border">
              <img
                src={r.artwork?.['300']?.jpg || r.cover}
                alt=""
                width="56"
                height="56"
                loading="lazy"
                class="size-[56px] shrink-0 object-cover"
              />
              <div class="min-w-0 flex flex-col gap-0.5">
                <a
                  href={`/releases/${r.catalog.toLowerCase()}`}
                  class="font-label font-semibold text-[0.8rem] uppercase tracking-[0.06em] text-fg no-underline after:absolute after:inset-0">
                  {r.title}
                </a>
                <span class="font-mono text-[0.55rem] tracking-[0.18em] uppercase text-fg-muted">
                  {[r.artist, yearOf(r)].filter(Boolean).join(' · ')}
                </span>
              </div>
            </li>
          ))}
        </ul>

        <div class="hidden sm:grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          {alsoOn.map((r) => <ReleaseCard release={r} />)}
        </div>
      </section>
    )}

    <!-- Previous / next: fixed links in the HTML, independent of the shuffled list above -->
    <nav aria-label="Release navigation" class="container mx-auto px-4 sm:px-6 lg:px-8 mt-8 sm:mt-16 pt-4 border-t border-border flex justify-between gap-6">
      {prev ? (
        <a href={`/releases/${prev.catalog.toLowerCase()}`} class="group block max-w-[45%] min-h-[44px] no-underline">
          <span class="block font-mono text-[0.55rem] tracking-[0.2em] uppercase text-accent mb-1">← Previous release</span>
          <span class="block font-label text-[0.8rem] uppercase tracking-[0.06em] text-fg line-clamp-2 transition-colors duration-200 group-hover:text-accent">{prev.title}</span>
        </a>
      ) : <span></span>}
      {next ? (
        <a href={`/releases/${next.catalog.toLowerCase()}`} class="group block max-w-[45%] min-h-[44px] text-right no-underline">
          <span class="block font-mono text-[0.55rem] tracking-[0.2em] uppercase text-accent mb-1">Next release →</span>
          <span class="block font-label text-[0.8rem] uppercase tracking-[0.06em] text-fg line-clamp-2 transition-colors duration-200 group-hover:text-accent">{next.title}</span>
        </a>
      ) : <span></span>}
    </nav>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

</BaseLayout>
