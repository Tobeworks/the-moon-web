---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';

const error = Astro.url.searchParams.get('error') ?? undefined;

const perks = [
  { label: 'Free',            detail: 'No cost, ever. This is a label list, not a product.' },
  { label: 'New releases',    detail: 'A transmission when something drops. Nothing in between.' },
  { label: 'No algorithm',    detail: 'Straight to your inbox. No feed deciding what you see.' },
  { label: 'Leave any time',  detail: 'One-click unsubscribe link in every email.' },
];
---

<BaseLayout
  title="Newsletter — THE MOON RECORDS"
  description="Join The Moon Records list. New releases, no noise. Free, no spam, unsubscribe any time."
>
  <div class="nl-page">
    <div class="nl-page__inner">

      <!-- ── Left: claim + perks ─────────────────────────────────────────── -->
      <div class="nl-page__intro">
        <span class="text-eyebrow">// TRANSMISSION_OPEN</span>

        <h1 class="nl-page__title">Join<br />the List.</h1>

        <p class="nl-page__sub">
          New releases. Label transmissions. No algorithm. No noise.
          Straight to your inbox when something worth hearing drops.
        </p>

        <ul class="nl-perks">
          {perks.map((p) => (
            <li class="nl-perks__item">
              <span class="nl-perks__marker">—</span>
              <span>
                <strong class="nl-perks__label">{p.label}</strong>
                <span class="nl-perks__detail">{p.detail}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>

      <!-- ── Right: form ─────────────────────────────────────────────────── -->
      <div class="nl-page__form">
        <NewsletterForm error={error} />
      </div>

    </div>

    <a href="/" class="nl-page__back uppercase">← Back to The Moon</a>
  </div>
</BaseLayout>

<style>
  .nl-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3rem;
    padding: 5rem 1.5rem 4rem;
  }

  .nl-page__inner {
    width: 100%;
    max-width: 68rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* Desktop — two columns, form sticks to the right */
  @media (min-width: 60rem) {
    .nl-page__inner {
      grid-template-columns: 1.1fr 1fr;
      gap: 5rem;
      align-items: center;
    }
  }

  .nl-page__intro {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .nl-page__title {
    font-family: var(--font-label);
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-fg);
    margin: 0;
    line-height: 1.02;
  }

  .nl-page__sub {
    font-family: var(--font-label);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-dim);
    line-height: 1.7;
    margin: 0;
    max-width: 32rem;
  }

  /* ── Perks ─────────────────────────────────────────────────────────────── */

  .nl-perks {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    border-top: 1px solid var(--color-accent-border);
    padding-top: 1.75rem;
  }

  .nl-perks__item {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .nl-perks__marker {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .nl-perks__label {
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-fg);
    display: block;
  }

  .nl-perks__detail {
    font-family: var(--font-label);
    font-weight: 300;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--color-fg-muted);
    line-height: 1.6;
    display: block;
    margin-top: 0.15rem;
  }

  /* ── Form panel ────────────────────────────────────────────────────────── */

  .nl-page__form {
    padding: 2rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface-low);
  }

  @media (min-width: 60rem) {
    .nl-page__form {
      padding: 2.5rem;
    }
  }

  /* ── Back link ─────────────────────────────────────────────────────────── */

  .nl-page__back {
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    text-decoration: none;
    transition: color 0.15s;
    align-self: center;
  }

  .nl-page__back:hover {
    color: var(--color-accent);
  }
</style>
