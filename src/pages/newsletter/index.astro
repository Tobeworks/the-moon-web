---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';

const error = Astro.url.searchParams.get('error') ?? undefined;

const perks = [
  { label: 'Free',           detail: 'No cost, ever. A label list, not a product.' },
  { label: 'New releases',   detail: 'A transmission when something drops. Nothing in between.' },
  { label: 'No algorithm',   detail: 'Straight to your inbox. No feed deciding what you see.' },
  { label: 'Leave any time', detail: 'One-click unsubscribe link in every email.' },
];
---

<BaseLayout
  title="Newsletter — THE MOON RECORDS"
  description="Join The Moon Records list. New releases, no noise. Free, no spam, unsubscribe any time."
>
  <div class="nl-hero">
    <div class="nl-hero__grid">

      <!-- ── Left: claim ───────────────────────────────────────────────────── -->
      <div class="nl-hero__intro">
        <span class="text-eyebrow">// TRANSMISSION_OPEN</span>

        <h1 class="nl-hero__title">Join<br />the List.</h1>

        <p class="nl-hero__sub">
          New releases. Label transmissions.<br />
          No algorithm. No noise.
        </p>

        <ul class="nl-perks">
          {perks.map((p) => (
            <li class="nl-perks__item">
              <span class="nl-perks__marker">—</span>
              <span class="nl-perks__body">
                <span class="nl-perks__label">{p.label}</span>
                <span class="nl-perks__detail">{p.detail}</span>
              </span>
            </li>
          ))}
        </ul>

        <a href="/" class="nl-hero__back">← Back to The Moon</a>
      </div>

      <!-- ── Right: form ───────────────────────────────────────────────────── -->
      <div class="nl-hero__panel">
        <NewsletterForm error={error} />
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  /* ── Shell ─────────────────────────────────────────────────────────────── */

  .nl-hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 8rem 1.5rem 5rem;
  }

  .nl-hero__grid {
    width: 100%;
    max-width: 70rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  @media (min-width: 62rem) {
    .nl-hero {
      padding: 9rem 3rem 6rem;
    }

    .nl-hero__grid {
      grid-template-columns: 1fr 0.85fr;
      gap: 7rem;
      align-items: center;
    }
  }

  /* ── Intro column ──────────────────────────────────────────────────────── */

  .nl-hero__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
  }

  .nl-hero__title {
    font-family: var(--font-label);
    font-size: clamp(2.8rem, 7.5vw, 5.2rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg);
    margin: 0;
    line-height: 1.04;
  }

  .nl-hero__sub {
    font-family: var(--font-label);
    font-weight: 300;
    font-size: 0.95rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-fg-faint);
    line-height: 1.9;
    margin: 0;
  }

  /* ── Perks — quiet, not shouty ─────────────────────────────────────────── */

  .nl-perks {
    list-style: none;
    margin: 0;
    padding: 2.25rem 0 0;
    width: 100%;
    max-width: 26rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border-top: 1px solid var(--color-accent-border);
  }

  .nl-perks__item {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
  }

  .nl-perks__marker {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-accent);
    flex-shrink: 0;
    line-height: 1.6;
  }

  .nl-perks__body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .nl-perks__label {
    font-family: var(--font-label);
    font-weight: 400;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-fg-dim);
  }

  .nl-perks__detail {
    font-family: var(--font-label);
    font-weight: 300;
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: var(--color-fg-muted);
    line-height: 1.65;
  }

  /* ── Back link — lives in the left column, never beside the form ───────── */

  .nl-hero__back {
    font-family: var(--font-label);
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    text-decoration: none;
    transition: color 0.15s;
    margin-top: 0.5rem;
  }

  .nl-hero__back:hover {
    color: var(--color-accent);
  }

  /* ── Form panel ────────────────────────────────────────────────────────── */

  .nl-hero__panel {
    padding: 2.25rem 1.75rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface-low);
  }

  @media (min-width: 62rem) {
    .nl-hero__panel {
      padding: 3rem 2.75rem;
    }
  }
</style>
