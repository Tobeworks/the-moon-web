---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';

const error = Astro.url.searchParams.get('error') ?? undefined;

const perks = [
  'Free — no cost, ever',
  'New releases, nothing in between',
  'No algorithm, no noise',
  'Unsubscribe any time',
];
---

<BaseLayout
  title="Newsletter — THE MOON RECORDS"
  description="Join The Moon Records list. New releases, no noise. Free, no spam, unsubscribe any time."
>
  <section
    class="relative grid grid-cols-1 md:grid-cols-2 min-h-dvh px-6 lg:px-10 pt-24 pb-16 md:pt-0 md:pb-0 overflow-hidden">

    <!-- Atmospheric glow -->
    <div
      class="absolute inset-0 pointer-events-none bg-[radial-gradient(ellipse_55%_50%_at_72%_48%,rgba(196,185,138,0.025)_0%,transparent_65%)]"
      aria-hidden="true">
    </div>

    <!-- ── Left: claim ─────────────────────────────────────────────────────── -->
    <div class="relative flex flex-col justify-center order-1 md:pr-12 lg:pr-20 md:py-24">

      <span class="flex items-center gap-3 font-mono text-[0.6rem] tracking-[0.35em] uppercase text-accent mb-8">
        <span class="block w-8 h-px bg-accent opacity-50 shrink-0"></span>
        Transmission — Open
      </span>

      <h1
        class="font-label font-bold uppercase text-fg mb-6 md:mb-8 text-[clamp(2.6rem,7vw,5.5rem)] tracking-[0.03em] leading-[0.9]">
        Join<br />the List
      </h1>

      <div class="w-full h-px bg-border mb-4 md:mb-6"></div>

      <p class="font-label font-light text-[0.75rem] tracking-[0.3em] uppercase text-fg-dim mb-10 md:mb-12">
        New releases straight to your inbox
      </p>

      <ul class="flex flex-col gap-3.5 mb-12">
        {perks.map((perk) => (
          <li class="flex items-baseline gap-3 font-mono text-[0.6rem] tracking-[0.22em] uppercase text-fg-muted">
            <span class="text-accent shrink-0">+</span>
            <span>{perk}</span>
          </li>
        ))}
      </ul>

      <a
        href="/"
        class="font-label font-light text-[0.65rem] tracking-[0.3em] uppercase text-fg-muted no-underline hover:text-accent transition-colors duration-200 self-start">
        ← Back to The Moon
      </a>
    </div>

    <!-- ── Right: form ─────────────────────────────────────────────────────── -->
    <div
      class="relative flex flex-col justify-center order-2 mt-16 pt-12 border-t border-border md:mt-0 md:pt-0 md:border-t-0 md:border-l md:border-border md:pl-12 lg:pl-20 md:py-24">

      <span class="font-mono text-[0.6rem] tracking-[0.35em] uppercase text-accent mb-8">
        // Sign_Up
      </span>

      <NewsletterForm error={error} />
    </div>

  </section>
</BaseLayout>
